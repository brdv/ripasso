#!/bin/sh
# Strip AI attribution from commit messages. Enabled in cloud sessions by scripts/session-start.sh;
# enable locally with: git config core.hooksPath .githooks

msg_file="$1"
tmp_file="$msg_file.tmp"

grep -v -i -E \
  -e '^Co-Authored-By:.*(anthropic\.com|openai\.com|ampcode\.com|sourcegraph\.com|Claude (Opus|Sonnet|Haiku|Fable|Code)|Codex)' \
  -e 'Generated with \[?Claude' \
  -e '^Claude-Session:' \
  -e 'claude\.ai/code/session' \
  "$msg_file" > "$tmp_file"

# Drop trailing blank lines left behind by removed trailers.
sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}' "$tmp_file" > "$msg_file"
rm -f "$tmp_file"
